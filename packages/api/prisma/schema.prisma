generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum AuthProvider {
  EMAIL
  GOOGLE
  GITHUB
  MICROSOFT
  APPLE
  PASSKEY
}

enum OrganizationTrustLevel {
  INDIVIDUAL
  BUSINESS
  GOVERNMENT
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

enum KycStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum KeyStatus {
  ACTIVE
  ROTATED
  REVOKED
}

enum DeviceTrustLevel {
  NEW
  TRUSTED
  SUSPICIOUS
  REVOKED
}

enum QRCodeStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum FraudType {
  DUPLICATE_LOCATION
  PROXY_DETECTED
  PATTERN_ANOMALY
  MANUAL_REPORT
  GEO_IMPOSSIBLE
}

enum FraudSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Organization {
  id                    String                 @id @default(cuid())
  name                  String
  slug                  String                 @unique
  email                 String                 @unique
  domain                String?
  trustLevel            OrganizationTrustLevel @default(INDIVIDUAL)
  kycStatus             KycStatus              @default(PENDING)
  kycData               Json?
  domainVerified        Boolean                @default(false)
  domainVerifyToken     String?
  plan                  Plan                   @default(FREE)
  billingEmail          String?
  stripeCustomerId      String?                @unique
  stripeSubscriptionId  String?
  // Security webhook (Audit-2 M-13 / ALGORITHM.md §16). HTTPS endpoint
  // the organization operates to receive signing-key lifecycle events.
  // Optional — orgs without a configured endpoint just log a warning
  // when a new key is minted. The secret is a 32-byte base64-encoded
  // random value, used as the HMAC-SHA3-256 key for every delivery.
  securityWebhookUrl    String?
  securityWebhookSecret String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  signingKeys       SigningKey[]
  qrCodes           QRCode[]
  apiKeys           ApiKey[]
  memberships       Membership[]
  invitations       Invitation[]
  auditLogs         AuditLog[]
  apps              App[]
  contentAssets     ContentAsset[]
  devicePolicy      DevicePolicy?
  signedBatches     SignedBatch[]
  macKeys           OrgMacKey[]
  usageSnapshots    UsageSnapshot[]
  ephemeralSessions EphemeralSession[]
  oidcClients       OidcClient[]

  @@map("organizations")
}

model SigningKey {
  id             String    @id @default(cuid())
  organizationId String
  publicKey      String
  keyId          String    @unique
  algorithm      String    @default("ES256")
  status         KeyStatus @default(ACTIVE)
  createdAt      DateTime  @default(now())
  rotatedAt      DateTime?
  revokedAt      DateTime?

  // Post-quantum SLH-DSA-SHA2-128s public key (base64). Paired with the
  // ECDSA key on the same row so a single rotation event swaps both legs.
  // Nullable to allow gradual rollout — keys created before the PQC layer
  // landed do not have an SLH-DSA pubkey.
  slhdsaPublicKey String?
  slhdsaAlgorithm String? @default("slh-dsa-sha2-128s")

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  qrCodes       QRCode[]
  signedBatches SignedBatch[]

  @@index([organizationId, status])
  @@map("signing_keys")
}

model QRCode {
  id                String       @id @default(cuid())
  token             String       @unique
  organizationId    String
  signingKeyId      String
  keyId             String? // Audit-4 A4-L2: public signing key identifier (UUID) for offline auditability
  destinationUrl    String
  label             String?
  contentType       String       @default("url")
  content           Json?
  contentVersion    Int          @default(1)
  publishedAt       DateTime?
  signature         String
  geoHash           String?
  latitude          Float?
  longitude         Float?
  radiusM           Float        @default(50)
  // When true (default), a geo-bound QR (latitude/longitude non-null) fails
  // closed at verification unless the scanner is inside the fence: see
  // routes/verify.ts. When false the binding is advisory — distance is still
  // computed and surfaced as `location_match`, but never blocks. Ignored
  // entirely when latitude/longitude are null.
  requireProximity  Boolean      @default(true)
  status            QRCodeStatus @default(ACTIVE)
  expiresAt         DateTime?
  maxScans          Int?
  maxScansPerDevice Int?
  revokedAt         DateTime?
  // AUDIT-2 N-1: structured revocation reason so the pending-reconciler
  // can distinguish an orphaned-merkle auto-revoke ('ORPHANED_PENDING_MERKLE')
  // from a user-driven revoke (null). Free-form string for now — callers
  // that need to branch on the reason match against a small set of
  // constants defined in services/pending-reconciler.ts. A future
  // migration can upgrade this to an enum if the reason set stabilises.
  revocationReason  String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Issue #62 (62c). Provenance marker so the pending-reconciler can
  // distinguish runtime-issued rows from rows planted by a seed script
  // or a bulk import. Today only the reconciler reads this — seed rows
  // skip the orphaned-pending auto-revoke because their lifecycle is
  // owned by the seed run, not the live merkle pipeline. Free-form
  // string for now; the small set of values in use is enumerated in
  // services/pending-reconciler.ts.
  source String? @default("runtime")

  // Post-quantum / hybrid signing fields. Populated when the QR code is
  // issued through the hybrid signing service. `algVersion` is the
  // authoritative discriminator at verification time:
  //   - "ecdsa-p256-sha256-v1"   → legacy single-signature row, REJECTED at
  //     verify since the canonical-form unification (alg-versions.ts).
  //   - "hybrid-ecdsa-slhdsa-v1" → ECDSA `signature` + Merkle batch fields
  //   - "slhdsa-sha2-128s-v1"    → reserved for Phase 3 ECDSA removal
  // The default is `hybrid-ecdsa-slhdsa-v1`: any row inserted without an
  // explicit override (seed scripts, tests, future paths) lands on the
  // accepted alg version. The previous default was `ecdsa-p256-sha256-v1`,
  // which has since been moved to REJECTED_ALG_VERSIONS — a row created
  // under that default would fail every verify, silently.
  algVersion      String? @default("hybrid-ecdsa-slhdsa-v1")
  merkleBatchId   String?
  merkleLeafIndex Int?
  merkleLeafHash  String?
  merkleLeafNonce String?
  merklePath      Json?

  // Hot-path symmetric MAC track (ALGORITHM.md §7). Computed at issuance over
  // the canonical payload using the org's HMAC-SHA3-256 key and stored
  // server-side only — never embedded in the QR. The verify route checks this
  // first as a fast path; on miss or version skew it falls through to the
  // ECDSA + Merkle/SLH-DSA legs which remain authoritative.
  macTokenMac   String?
  macKeyVersion Int?

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  signingKey           SigningKey            @relation(fields: [signingKeyId], references: [id])
  signedBatch          SignedBatch?          @relation(fields: [merkleBatchId], references: [batchId])
  scans                Scan[]
  fraudIncidents       FraudIncident[]
  transparencyLogEntry TransparencyLogEntry?
  contentAssets        ContentAsset[]
  feedbackSubmissions  FeedbackSubmission[]

  @@index([organizationId])
  @@index([status])
  @@index([keyId])
  @@map("qr_codes")
}

model Scan {
  id              String   @id @default(cuid())
  qrCodeId        String
  clientIpHash    String
  clientLat       Float?
  clientLng       Float?
  userAgent       String?
  trustScore      Int      @default(100)
  proxyDetected   Boolean  @default(false)
  passkeyVerified Boolean  @default(false)
  metadata        Json?
  createdAt       DateTime @default(now())

  qrCode         QRCode          @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  fraudIncidents FraudIncident[]

  @@index([qrCodeId])
  @@index([createdAt])
  @@map("scans")
}

model FraudIncident {
  id             String        @id @default(cuid())
  qrCodeId       String
  scanId         String?
  type           FraudType
  severity       FraudSeverity
  details        Json
  resolved       Boolean       @default(false)
  resolvedAt     DateTime?
  resolvedBy     String?
  resolutionNote String?
  acknowledgedAt DateTime?
  createdAt      DateTime      @default(now())

  qrCode QRCode @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  scan   Scan?  @relation(fields: [scanId], references: [id])

  @@index([qrCodeId])
  @@index([severity])
  @@index([resolved])
  @@map("fraud_incidents")
}

model TransparencyLogEntry {
  id              String   @id @default(cuid())
  logIndex        Int      @unique @default(autoincrement())
  qrCodeId        String   @unique
  organizationId  String
  tokenHash       String
  destinationHash String
  geoHash         String?
  previousHash    String?
  entryHash       String
  createdAt       DateTime @default(now())

  // Commitment-only fields (ALGORITHM.md §8). Populated for entries written
  // by the hybrid signing pipeline. Old fields above are retained for
  // backwards-compatible audit reads on legacy rows. New entries SHOULD
  // populate the commitment fields and SHOULD NOT depend on the legacy ones.
  // Default mirrors QRCode.algVersion — the previous `ecdsa-p256-sha256-v1`
  // default is now REJECTED at verify, so log entries minted via that
  // default would index a row no verifier will accept.
  algVersion           String? @default("hybrid-ecdsa-slhdsa-v1")
  commitment           String?
  batchRootRef         String?
  merkleInclusionProof Json?

  qrCode QRCode @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@index([logIndex])
  @@map("transparency_log")
}

// ---------------------------------------------------------------------------
// SignedBatch — a Merkle root that has been signed once with SLH-DSA. Each
// QRCode references its batch via QRCode.merkleBatchId. For now batches are
// single-leaf (one QR per batch) so issuance latency is dominated by SLH-DSA
// signing; multi-leaf batching is a future optimization (ALGORITHM.md §6.2)
// that requires no additional schema changes.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// OrgMacKey — versioned HMAC-SHA3-256 key ring per organization. Drives the
// symmetric fast path (ALGORITHM.md §7). Each row is one *version* of the
// secret; the active row has `status = ACTIVE`. On rotation the previous
// ACTIVE row flips to ROTATED and stays around for a grace period so QRs
// signed under it still verify; after the grace window it's marked RETIRED
// and pruned by a cleanup worker (not yet implemented — Phase 2.5).
//
// `secret` stores the raw HMAC key as base64. In production this should
// move into KMS and be fetched per-request rather than cached in the row.
// For MVP it lives here so the verify path has a single DB read instead of
// a KMS round-trip on every scan.
// ---------------------------------------------------------------------------

model OrgMacKey {
  id             String       @id @default(cuid())
  organizationId String
  version        Int
  secret         String
  algorithm      String       @default("hmac-sha3-256")
  status         MacKeyStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  rotatedAt      DateTime?
  retiredAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, version])
  @@index([organizationId, status])
  @@map("org_mac_keys")
}

enum MacKeyStatus {
  ACTIVE
  ROTATED
  RETIRED
}

model SignedBatch {
  id             String   @id @default(cuid())
  batchId        String   @unique
  organizationId String
  signingKeyId   String
  algVersion     String   @default("hybrid-ecdsa-slhdsa-v1")
  merkleRoot     String
  rootSignature  String // SLH-DSA signature of merkleRoot, base64
  tokenCount     Int
  issuedAt       DateTime
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  signingKey   SigningKey   @relation(fields: [signingKeyId], references: [id])
  qrCodes      QRCode[]

  @@index([organizationId])
  @@index([signingKeyId])
  @@map("signed_batches")
}

model ApiKey {
  id              String         @id @default(cuid())
  organizationId  String
  keyHash         String         @unique
  prefix          String
  label           String?
  role            MembershipRole @default(MEMBER)
  createdByUserId String?
  source          String?
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([createdByUserId])
  @@map("api_keys")
}

model User {
  id                   String       @id @default(cuid())
  name                 String
  email                String       @unique
  passwordHash         String
  provider             AuthProvider @default(EMAIL)
  providerId           String?      @unique
  avatarUrl            String?
  failedLoginAttempts  Int          @default(0)
  lockedUntil          DateTime?
  onboardedAt          DateTime?
  emailVerified        Boolean      @default(false)
  emailVerifyToken     String?      @unique
  passwordResetToken   String?      @unique
  passwordResetExpires DateTime?
  lastLoginAt          DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  memberships        Membership[]
  invitationsSent    Invitation[]       @relation("InvitedByUser")
  invitedMemberships Membership[]       @relation("InvitedByMembership")
  auditLogs          AuditLog[]
  authSessions       AuthSession[]
  loginEvents        LoginEvent[]
  refreshTokens      RefreshToken[]
  trustedDevices     TrustedDevice[]
  passkeys           Passkey[]
  oidcAuthCodes      OidcAuthCode[]
  oidcConsents       OidcConsent[]
  oidcRefreshTokens  OidcRefreshToken[]
  oidcSessions       OidcSession[]
  oidcAccessTokens   OidcAccessToken[]

  @@map("users")
}

model LoginEvent {
  id          String       @id @default(cuid())
  userId      String
  success     Boolean
  provider    AuthProvider @default(EMAIL)
  ipAddress   String?
  ipCountry   String?
  ipCity      String?
  userAgent   String?
  deviceType  String?
  browser     String?
  os          String?
  fingerprint String?
  metadata    Json?
  createdAt   DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([ipAddress])
  @@map("login_events")
}

model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole @default(MEMBER)
  invitedBy      String?
  joinedAt       DateTime       @default(now())
  createdAt      DateTime       @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User?        @relation("InvitedByMembership", fields: [invitedBy], references: [id])

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

model Invitation {
  id             String         @id @default(cuid())
  organizationId String
  email          String
  role           MembershipRole @default(MEMBER)
  token          String         @unique
  invitedBy      String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation("InvitedByUser", fields: [invitedBy], references: [id])

  @@index([organizationId])
  @@index([email])
  @@map("invitations")
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  action         String
  resource       String
  resourceId     String
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
  @@index([userId])
  @@map("audit_logs")
}

enum EphemeralSessionStatus {
  PENDING
  CLAIMED
  EXPIRED
  REVOKED
}

enum AppStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum AuthSessionStatus {
  PENDING
  SCANNED
  APPROVED
  DENIED
  EXPIRED
}

model App {
  id               String    @id @default(cuid())
  organizationId   String
  name             String
  slug             String    @unique
  clientId         String    @unique
  clientSecretHash String
  redirectUrls     String[]
  webhookUrl       String?
  allowedScopes    String[]  @default(["identity"])
  logoUrl          String?
  description      String?
  status           AppStatus @default(ACTIVE)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authSessions      AuthSession[]
  webhookDeliveries WebhookDelivery[]
  ephemeralSessions EphemeralSession[]

  @@index([organizationId])
  @@map("apps")
}

model AuthSession {
  id                   String            @id @default(cuid())
  appId                String
  token                String            @unique
  status               AuthSessionStatus @default(PENDING)
  scopes               String[]          @default(["identity"])
  codeChallenge        String? // PKCE S256 challenge (for browser SDK, no secret needed)
  userId               String?
  userAgent            String?
  clientIpHash         String?
  deviceFingerprint    String?
  ipCountry            String?
  ipCity               String?
  referrer             String?
  geoLat               Float?
  geoLng               Float?
  signature            String?
  redirectUrl          String?
  metadata             Json?
  targetOrganizationId String?
  exchangedAt          DateTime?
  expiresAt            DateTime
  scannedAt            DateTime?
  resolvedAt           DateTime?
  createdAt            DateTime          @default(now())

  app  App   @relation(fields: [appId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@index([appId])
  @@index([token])
  @@index([status, expiresAt])
  @@map("auth_sessions")
}

// ---------------------------------------------------------------------------
// UsageSnapshot — periodic capture of the live Redis quota counter into
// Postgres for billing audit / customer-dispute resolution past the 35-day
// Redis TTL. Issue #65 adds the model only; the worker that populates it
// is filed as #83 (deferred deliberately).
//
// One row per (organizationId, metric, period). The unique index on that
// triple lets the worker upsert idempotently without coordination across
// nodes. `capturedAt` records when the snapshot was taken — useful for
// reconstructing what the meter said at end-of-month vs intra-month.
// ---------------------------------------------------------------------------

model UsageSnapshot {
  id             String   @id @default(cuid())
  organizationId String
  metric         String // matches values in UsageMetric
  period         String // YYYY-MM
  count          Int
  capturedAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, metric, period])
  @@index([organizationId, period])
  @@map("usage_snapshots")
}

model AnalyticsSnapshot {
  id          String   @id @default(cuid())
  type        String
  entityType  String
  entityId    String
  periodStart DateTime
  periodEnd   DateTime
  data        Json
  createdAt   DateTime @default(now())

  @@index([type, entityType, periodStart])
  @@index([entityId, type])
  @@map("analytics_snapshots")
}

model FraudRule {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  enabled     Boolean  @default(true)
  priority    Int      @default(100)
  conditions  Json
  action      Json
  source      String   @default("system")
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled, priority])
  @@map("fraud_rules")
}

model AgentRun {
  id            String    @id @default(cuid())
  runType       String
  status        String
  inputSummary  Json?
  outputSummary Json?
  tokensUsed    Int?
  durationMs    Int?
  error         String?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  @@index([runType, createdAt])
  @@map("agent_runs")
}

model ContentAsset {
  id             String   @id @default(cuid())
  organizationId String
  qrCodeId       String?
  filename       String
  mimeType       String
  sizeBytes      Int
  storagePath    String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  qrCode       QRCode?      @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([qrCodeId])
  @@map("content_assets")
}

model FeedbackSubmission {
  id        String   @id @default(cuid())
  qrCodeId  String
  rating    Int
  comment   String?
  name      String?
  email     String?
  phone     String?
  ipHash    String?
  userAgent String?
  createdAt DateTime @default(now())

  qrCode QRCode @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@index([qrCodeId, createdAt])
  @@map("feedback_submissions")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  family    String // Token family for rotation detection
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model WebhookDelivery {
  id            String    @id @default(cuid())
  appId         String
  event         String // e.g. qr.created, qr.scanned, qr.verified, fraud.detected, auth.approved, auth.denied
  url           String
  payload       Json
  statusCode    Int?
  responseBody  String?
  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  deliveredAt   DateTime?
  failedAt      DateTime?
  error         String?
  createdAt     DateTime  @default(now())

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId, createdAt])
  @@index([event, createdAt])
  @@map("webhook_deliveries")
}

// ---------------------------------------------------------------------------
// Device Registry & WebAuthn
// ---------------------------------------------------------------------------

model TrustedDevice {
  id          String           @id @default(cuid())
  userId      String
  fingerprint String
  name        String?
  trustLevel  DeviceTrustLevel @default(NEW)
  deviceType  String?
  browser     String?
  os          String?
  ipCountry   String?
  ipCity      String?
  lastSeenAt  DateTime         @default(now())
  trustedAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime         @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  passkeys Passkey[]

  @@unique([userId, fingerprint])
  @@index([userId, trustLevel])
  @@map("trusted_devices")
}

model Passkey {
  id           String    @id @default(cuid())
  userId       String
  deviceId     String?
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  transports   String[]
  aaguid       String?
  name         String?
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  // Post-quantum bridge credential (ALGORITHM.md §9). The WebAuthn key
  // itself is ECDSA-P256 — quantum-vulnerable to Shor's algorithm. The
  // bridge is a parallel ML-DSA-44 credential generated server-side at
  // registration: the public key lives here, the private key was returned
  // once to the client and stored in browser IndexedDB. At authentication
  // the client signs the WebAuthn challenge with both keys; the server
  // verifies both legs. Even after CRQC breaks ECDSA, the ML-DSA leg
  // still holds.
  //
  // Nullable for backwards compatibility: legacy passkeys registered
  // before this layer landed have no bridge keypair, and the verifier
  // accepts them without a bridge signature (logged as a downgrade).
  bridgePublicKey Bytes?
  bridgeAlgorithm String? @default("ml-dsa-44")

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  device TrustedDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("passkeys")
}

// ---------------------------------------------------------------------------
// Ephemeral Delegated Access
// ---------------------------------------------------------------------------

model EphemeralSession {
  id              String                 @id @default(cuid())
  // Org the session is scoped to (authoritative). Direct, like QRCode — so an
  // org-scoped credential (API key / dashboard JWT) can manage ephemeral
  // sessions, not just app client-credentials (ADR-0002 step 8).
  organizationId  String
  // Creating app, when created via app client-credentials. Null for sessions
  // created by an org-scoped credential (API key / JWT) — provenance only.
  appId           String?
  token           String                 @unique
  status          EphemeralSessionStatus @default(PENDING)
  scopes          String[]               @default([])
  ttlSeconds      Int
  maxUses         Int                    @default(1)
  useCount        Int                    @default(0)
  deviceBinding   Boolean                @default(false)
  boundDeviceHash String?
  metadata        Json?
  claimUrl        String?
  claimedAt       DateTime?
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime               @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  app          App?         @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([appId])
  @@index([token])
  @@index([status, expiresAt])
  @@map("ephemeral_sessions")
}

// ---------------------------------------------------------------------------
// Device Policy
// ---------------------------------------------------------------------------

model DevicePolicy {
  id                  String   @id @default(cuid())
  organizationId      String   @unique
  maxDevices          Int      @default(10)
  requireBiometric    Boolean  @default(false)
  geoFenceLat         Float?
  geoFenceLng         Float?
  geoFenceRadiusKm    Float?
  autoRevokeAfterDays Int?
  // Post-quantum WebAuthn bridge enforcement (ALGORITHM.md §9). One of:
  //   - "required" (default): bridge signature MUST verify; missing or
  //     invalid → auth fails. Forces re-registration if the user clears
  //     IndexedDB. Recommended for government / regulated tenants.
  //   - "optional": bridge signature verified when present, accepted
  //     (with a warn log) when absent. Lets users clear site data
  //     without bricking auth. Recommended for standard tenants until
  //     PQC WebAuthn is standardized.
  //   - "disabled": no bridge keypair minted at registration, no
  //     bridge check at auth. Useful for tenants on legacy stacks
  //     where the extra round trip is not worth the latency.
  // Strictness order for cross-org users: required > optional > disabled.
  bridgePolicy        String   @default("required")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("device_policies")
}

// ---------------------------------------------------------------------------
// OIDC Provider (ADR-0003)
//
// Clean-slate OIDC models for the id.qrauth.io OpenID Provider. Deliberately
// separate from the auth-sessions App/AuthSession surface (different protocol,
// different terminal output — a signed federated assertion vs. an
// authorization_code redeemed for an ID token). Phase 1 Slice 1 lands the
// schema only; no protocol logic ships in this slice.
//
// OidcClient is the OIDC RP registration; App remains the federation/SDK
// client. Every client is scoped to an Organization by FK — the non-negotiable
// multi-tenant isolation boundary (ADR §"RP model — three tiers, one OP").
// ---------------------------------------------------------------------------

enum OidcClientTier {
  FIRST_PARTY
  CUSTOMER
  PUBLIC
}

// PKCE method. S256 only — plain is rejected for every client, every tier
// (ADR §"PKCE is mandatory for all clients"). Modeled as a single-value enum
// so the database itself rejects any other method.
enum OidcCodeChallengeMethod {
  S256
}

model OidcClient {
  id                  String         @id @default(cuid())
  organizationId      String
  // clientId is globally unique: the /authorize and /token endpoints receive
  // it without an org context, so it must resolve to exactly one client.
  // Mirrors App.clientId (@unique). Org scoping is the @@index below.
  clientId            String         @unique
  // Nullable for public clients (PKCE-only, no secret). Confidential clients
  // store a hash, same posture as App.clientSecretHash.
  clientSecretHash    String?
  name                String
  redirectUris        String[]
  allowedScopes       String[]       @default(["openid"])
  tier                OidcClientTier @default(FIRST_PARTY)
  // Pairwise sub support when redirect_uris span hosts. Slice 3 uses it.
  sectorIdentifierUri String?
  // ADR-0003 Slice 7b — OIDC Core §2 `id_token_signed_response_alg`. Default
  // RS256 (mandatory-to-implement baseline, OIDC Core §15.1); 'ES256' is opt-in.
  // /token resolves this to pick the platform signing key + JWS alg header.
  idTokenSignedResponseAlg String     @default("RS256")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authCodes     OidcAuthCode[]
  consents      OidcConsent[]
  refreshTokens OidcRefreshToken[]
  accessTokens  OidcAccessToken[]

  @@index([organizationId])
  @@map("oidc_clients")
}

model OidcAuthCode {
  id                  String                  @id @default(cuid())
  // Codes are hashed, never stored raw.
  codeHash            String                  @unique
  oidcClientId        String
  userId              String
  redirectUri         String // echoed back at /token per RFC 6749 §4.1.3
  scope               String // space-separated, OAuth convention
  codeChallenge       String
  codeChallengeMethod OidcCodeChallengeMethod @default(S256)
  nonce               String? // echoed into the ID token when present
  authTime            DateTime // when the user actually authenticated
  expiresAt           DateTime // 10 minutes from issuance
  usedAt              DateTime? // set on redemption — single-use enforcement
  createdAt           DateTime                @default(now())

  client OidcClient @relation(fields: [oidcClientId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([oidcClientId])
  @@index([userId])
  @@index([expiresAt])
  @@map("oidc_auth_codes")
}

model OidcConsent {
  id            String    @id @default(cuid())
  userId        String
  oidcClientId  String
  grantedScopes String[]
  grantedAt     DateTime  @default(now())
  revokedAt     DateTime?

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  client OidcClient @relation(fields: [oidcClientId], references: [id], onDelete: Cascade)

  // One live consent per (user, client) — the latest grant supersedes prior.
  @@unique([userId, oidcClientId])
  @@index([oidcClientId])
  @@map("oidc_consents")
}

// OIDC refresh tokens. Distinct from the dashboard-session RefreshToken model
// above (which is user-scoped, table refresh_tokens). This one is client-scoped
// with a rotation chain and family-based reuse detection per ADR §"Refresh
// tokens": 14-day TTL, rotate on every use, kill the whole family on replay of
// a rotated token, store hashed only.
model OidcRefreshToken {
  id           String    @id @default(cuid())
  tokenHash    String    @unique // hashed, never raw
  familyId     String // all tokens from one auth grant share this — reuse detection
  oidcClientId String
  userId       String
  scope        String
  expiresAt    DateTime // 14 days from issuance
  rotatedAt    DateTime? // set when a successor in the family is issued
  revokedAt    DateTime? // set when the family is invalidated
  replacedById String?   @unique // next token in the rotation chain
  authTime     DateTime? // original end-user auth event (OIDC Core §12.2): refreshed ID tokens MUST echo it unchanged; inherited across rotations. Nullable for pre-migration rows.
  createdAt    DateTime  @default(now())

  client     OidcClient        @relation(fields: [oidcClientId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy OidcRefreshToken? @relation("OidcRefreshTokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   OidcRefreshToken? @relation("OidcRefreshTokenRotation")

  @@index([familyId])
  @@index([oidcClientId])
  @@index([userId])
  @@index([expiresAt])
  @@map("oidc_refresh_tokens")
}

// OP-hosted login session (ADR-0003 Slice 3b). The OP is its own auth
// surface (per ADR Q4): /login resolves the QRAuth user via the
// auth-sessions scan-approval mechanism and mints one of these. /authorize
// reads it from the host-only `qrauth_op_session` cookie on id.qrauth.io.
// Distinct from the dashboard's user-scoped RefreshToken model and from
// OidcRefreshToken (which is client-scoped). Opaque token, stored hashed.
model OidcSession {
  id               String    @id @default(cuid())
  sessionTokenHash String    @unique // opaque 32-byte token, SHA-256 hashed
  userId           String
  createdAt        DateTime  @default(now())
  expiresAt        DateTime // 24h from creation
  revokedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("oidc_sessions")
}

// OIDC access tokens (ADR-0003 Slice 3b). Phase 1 issues opaque bearer
// access tokens (Slice 4's /userinfo validates them); refresh tokens are
// Slice 5. Stored hashed only.
model OidcAccessToken {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  oidcClientId String
  userId       String
  scope        String
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  client OidcClient @relation(fields: [oidcClientId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([oidcClientId])
  @@index([userId])
  @@index([expiresAt])
  @@map("oidc_access_tokens")
}
