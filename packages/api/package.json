{
  "name": "@qrauth/api",
  "version": "0.1.2",
  "author": {
    "name": "Gernard Cerma",
    "email": "aris@progressnet.gr",
    "url": "https://github.com/qrauth-io"
  },
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "prebuild": "prisma generate",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:preview-bench": "tsx --env-file=.env scripts/seed-preview-bench.ts",
    "db:seed:analytics": "tsx --env-file=.env scripts/seed-analytics-dev.ts",
    "db:seed:organize": "tsx --env-file=.env scripts/seed-qr-organize-dev.ts",
    "db:seed:audit": "tsx --env-file=.env scripts/seed-audit-dev.ts",
    "db:seed:policies": "tsx --env-file=.env scripts/seed-policies-dev.ts",
    "oidc:bootstrap-key": "tsx --env-file=.env scripts/bootstrap-platform-oidc-key.ts",
    "oidc:bootstrap-rsa-key": "tsx --env-file=.env scripts/bootstrap-platform-rsa-key.ts",
    "oidc:ab-check": "tsx scripts/oidc-ab-check.ts",
    "lookalike:simulate": "tsx --env-file-if-exists=.env scripts/lookalike-simulate.ts",
    "oidc:seed-test-client": "tsx --env-file=.env scripts/seed-phase1-test-client.ts",
    "oidc:teardown-test-client": "tsx --env-file=.env scripts/teardown-phase1-test-client.ts",
    "user:provision": "tsx --env-file=.env scripts/provision-managed-user.ts",
    "oidc:set-trusted": "tsx --env-file=.env scripts/oidc-set-trusted.ts",
    "org:create": "tsx --env-file=.env scripts/create-org.ts",
    "db:studio": "prisma studio",
    "test": "vitest",
    "lint": "eslint src"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/jwt": "^10.2.6",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/sensible": "^6.0.7",
    "@fastify/static": "^10.1.8",
    "@noble/post-quantum": "^0.7.1",
    "@prisma/client": "^6.0.0",
    "@qrauth/shared": "*",
    "@simplewebauthn/server": "^14.0.3",
    "bowser": "2.15.0",
    "bullmq": "^5.81.5",
    "csv-parse": "^7.0.3",
    "fastify": "^5.12.8",
    "fastify-plugin": "^5.0.0",
    "fflate": "^0.8.3",
    "ioredis": "^5.4.0",
    "jose": "^6.2.14",
    "mmdb-lib": "3.0.4",
    "nodemailer": "^10.3.1",
    "pdfkit": "0.20.2",
    "qrcode": "1.5.4",
    "sharp": "0.35.5",
    "stripe": "^17.0.0",
    "zod": "^4.1.13",
    "zxing-wasm": "3.1.6"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.1.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "0.17.7",
    "@types/qrcode": "^1.5.6",
    "dotenv": "^16.6.1",
    "jsdom": "^25.0.1",
    "jsqr": "1.4.0",
    "pdfjs-dist": "6.5.438",
    "pino-pretty": "^13.2.0",
    "prisma": "^6.0.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^4.1.12"
  }
}
