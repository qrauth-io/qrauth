{
  "name": "@qrauth/api",
  "version": "0.1.2",
  "author": {
    "name": "Gernard Cerma",
    "email": "aris@progressnet.gr",
    "url": "https://github.com/qrauth-io"
  },
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "prebuild": "prisma generate",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:preview-bench": "tsx --env-file=.env scripts/seed-preview-bench.ts",
    "oidc:bootstrap-key": "tsx --env-file=.env scripts/bootstrap-platform-oidc-key.ts",
    "oidc:bootstrap-rsa-key": "tsx --env-file=.env scripts/bootstrap-platform-rsa-key.ts",
    "oidc:seed-test-client": "tsx --env-file=.env scripts/seed-phase1-test-client.ts",
    "oidc:teardown-test-client": "tsx --env-file=.env scripts/teardown-phase1-test-client.ts",
    "db:studio": "prisma studio",
    "test": "vitest",
    "lint": "eslint src"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/sensible": "^6.0.5",
    "@fastify/static": "^9.1.3",
    "@noble/post-quantum": "^0.7.0",
    "@prisma/client": "^6.0.0",
    "@qrauth/shared": "*",
    "@simplewebauthn/server": "^11.0.0",
    "bullmq": "^5.76.10",
    "fastify": "^5.12.1",
    "fastify-plugin": "^5.0.0",
    "ioredis": "^5.4.0",
    "jose": "^6.2.9",
    "nodemailer": "^8.0.7",
    "qrcode": "^1.5.4",
    "stripe": "^17.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "dotenv": "^16.6.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
