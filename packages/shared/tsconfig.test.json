{
  // Type-checks everything under src, tests included, without emitting.
  // tsconfig.json excludes the tests from the published build.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src", "vitest.config.ts"],
  "exclude": []
}
